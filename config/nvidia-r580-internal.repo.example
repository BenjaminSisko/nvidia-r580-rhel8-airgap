# Replace example URLs with the approved internal HTTPS repository URLs.
# Install public signing keys only after verifying their provenance.
[nvidia-r580-rhel8-internal]
name=Internal NVIDIA R580 Open-DKMS EL8 driver repository
baseurl=https://repo.example.mil/repos/nvidia-r580-rhel8/drivers/
enabled=1
gpgcheck=1
# This workflow regenerates unsigned metadata; use approved authenticated TLS.
repo_gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/NVIDIA-GPG-KEY-D42D0685.pub
sslverify=1
# Review modular filtering failures before changing module_hotfixes.
# module_hotfixes=1

[nvidia-r580-rhel8-os-deps]
# Verified AppStream modular runtime RPMs are carried without full upstream
# Red Hat module metadata; scope this override to this dependency repository.
module_hotfixes=1
name=Offline RHEL 8.10 kernel, DKMS and full driver runtime dependencies
baseurl=https://repo.example.mil/repos/nvidia-r580-rhel8/os-deps/
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release,file:///etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL-8
# These public RPM signing keys are carried in repo-bundle/keys/.
# Never copy Red Hat entitlement certificates or CDN client keys to clients.
sslverify=1
